<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.54.4" />
    <PackageReference Include="niflysharp" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hand-painted alpha mask for DirtCliffsSnowVariantGenerator's one hardcoded texture pair -
         embedded rather than shipped as a loose file, so the native shell doesn't need its own
         copy step just for this one asset. -->
    <EmbeddedResource Include="Assets\DirtCliffsRootsAlpha.png" />
  </ItemGroup>

</Project>
